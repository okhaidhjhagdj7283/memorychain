# ================================================================
# MemoryChain — Environment Variables
# Dự án 100% SQLite, không cần database server nào cả.
# ================================================================

# Database — SQLite (file local, tự tạo khi chạy prisma db push)
# Dùng đường dẫn TUYỆT ĐỐI để tránh lỗi khi chạy từ nhiều thư mục
# Thay /root/memorychain bằng đường dẫn thực tế của bạn
DATABASE_URL="file:/root/memorychain/packages/db/prisma/dev.db"

# Auth
JWT_SECRET="memorychain-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Shelby Protocol (Blob Storage cho ảnh/video)
SHELBY_RPC_URL="https://api.testnet.shelby.xyz/shelby"
SHELBY_API_KEY=""

# Aptos Blockchain
APTOS_NODE_URL="https://api.testnet.aptoslabs.com/v1"
APTOS_NETWORK="testnet"

# Next.js Public (client-side)
NEXT_PUBLIC_SHELBY_RPC_URL="https://api.testnet.shelby.xyz/shelby"
NEXT_PUBLIC_APTOS_NETWORK="testnet"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
